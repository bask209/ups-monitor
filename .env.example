# Telegram (optional): create a bot with @BotFather, put the token here.
# Get your numeric Telegram user ID (e.g. from @userinfobot) and put it below; the bot only answers that private chat.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Unused (reserved for a Telegram Mini App URL; leave empty)
WEBAPP_URL=
DASHBOARD_URL=http://<host-ip>:8330
TZ=America/Bogota
LOAD_ALERT_PCT=80
# KWH_PRICE=0.0
# CURRENCY=COP
# Daily 08:00 summary message (off = text only when something happens)
DIGEST_ENABLED=false
